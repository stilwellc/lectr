# ── Security headers (site-wide) ─────────────────────────────────────────────
# CONTENT-SECURITY-POLICY (enforced, Sep 27 2026). Keep it on ONE line —
# scripts/csp-postbuild.ts parses it and fails the build if any inline script
# left in out/ is not hash-listed here, or if the baked Supabase origin is not
# in connect-src.
#   script-src  'self' + ONE hash: the porcelain theme boot in app/layout.tsx
#               (edit that script → the build prints the new hash to paste
#               here). Next's per-page inline RSC flight scripts (3,600+ unique
#               bodies) are moved into /_next/static/chunks/flight/<hash>.js by
#               csp-postbuild, so no 'unsafe-inline' and no per-page hashes.
#               + https://static.cloudflareinsights.com/beacon.min.js/ (r8): the
#               zone has Cloudflare Web Analytics on, so the edge injects its
#               beacon (<script src=…/beacon.min.js/v…> with an SRI integrity
#               hash) into every page — and this policy blocked it: a console
#               error on every page and zero analytics. Allowed by path prefix
#               (that one script, version-pinned by its integrity attribute),
#               per Cloudflare's CSP guidance; the beacon is cookieless and
#               posts to same-origin /cdn-cgi/rum, which connect-src 'self'
#               already covers. (The alternative — Cache-Control: no-transform
#               on HTML to stop the injection — would also block edge
#               compression and silently keep a dashboard someone turned on
#               dead; switching it off belongs in the Cloudflare dashboard.)
#   style-src   'unsafe-inline' is required: the export carries ~13.5K style=""
#               attributes (React SSR) plus <style> blocks per route. Style
#               injection cannot execute script under this script-src.
#   img-src     https: — lot photos come straight from 35+ auction-house CDNs
#               (christies, brightspot, digitaloceanspaces, cloudfront, bonhams
#               images1-3, cloudinary, bidsquare, …) and every new crawler adds
#               more; an allow-list would silently blank a house's photos on
#               the night it lands. Images cannot run script.
#   connect-src same-origin data shards + the Supabase project (auth + saved
#               lots + /rest/v1/lots). No third-party analytics hosts are
#               called (the Web Analytics beacon posts same-origin).
# frame-ancestors 'none' + X-Frame-Options block clickjacking of the login
# modal. HSTS pins https; adding `preload` (and submitting to hstspreload.org)
# is Collin's call — it is hard to undo.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-HE/v6bj/M7TOjC32nQkQiq+zDWeWUOfe3gzeMhLIQqA=' https://static.cloudflareinsights.com/beacon.min.js/; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://tiwrdomqydtnmgljsqsi.supabase.co; media-src 'self'; frame-src 'none'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Content-hashed build output (chunks, css, fonts, flight payloads, and the
# per-build buildId dir) never changes under a given URL — freeze it.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Next's static export emits the OG share card as an extensionless file
# (/opengraph-image), which Cloudflare serves as application/octet-stream —
# so iMessage/Twitter/Slack refuse to render it and fall back to the tiny
# no-photo preview. Force the real image content-type so the card shows.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600
/*/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600

# ── Versioned data shards: immutable long-lived cache ────────────────────────
# The client fetches these WITH a ?v=<lastCrawl> query param (force-cache), so
# every URL is already cache-busted per crawl — a new crawl is a new URL. Yet
# Cloudflare Pages serves them with `public, max-age=0, must-revalidate`, so
# each load pays a revalidation round-trip for nothing. Freeze them.
#
# _headers matches on PATH, not query string, so these globs match the whole
# family (lots-0.json … lots-5.json AND lots-index.json; sold-archive-0/1.json
# AND sold-archive-index.json; sold-ledger-0/1.json AND sold-ledger-index.json)
# — all of which are ?v=<lastCrawl>-busted in useRayData.ts (loadFull,
# loadSoldArchive, loadSoldLedger). sold-ledger-* was missing from this list
# until Sep 2 2026 and revalidated on every /profile load for nothing.
#
# Deliberately NOT `/data/ray/*.json` (too broad): the phase-1 files
# meta/upcoming/stats/market/backtest.json are fetched WITHOUT ?v= (L179-183)
# and MUST keep revalidating to pick up a new crawl. players.json / refs.json
# likewise stay untouched. These name-prefixed globs match none of them.
/data/ray/lots-*
  Cache-Control: public, max-age=31536000, immutable
/data/ray/sold-archive-*
  Cache-Control: public, max-age=31536000, immutable
/data/ray/sold-ledger-*
  Cache-Control: public, max-age=31536000, immutable
